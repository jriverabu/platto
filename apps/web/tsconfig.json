{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@platto/core": [
        "../../packages/core/src/index.ts"
      ],
      "@platto/demo": [
        "../../packages/demo/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/demo/src"
  ]
}
